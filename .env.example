# API ключи
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
CUSTOM_API_KEY=
CUSTOM_API_URL=
OLLAMA_URL=http://localhost:11434
HF_TOKEN=hf_...  # HuggingFace токен для диаризации (WhisperX)

# Перевод
TRANSLATE_PROVIDER=claude
TRANSLATE_MODEL=claude-haiku-4-5

# Транскрипция
TRANSCRIBE_ENGINE=openai-whisper
WHISPER_MODEL=large-v3
SEPARATE_VOCALS=true

# TTS
TTS_ENGINE=qwen3-1.7b-base
TTS_VOICE=Николай
TTS_SEED=44
TTS_TEMPERATURE=0.7

# Сборка
BUILD_FORMAT=mp4
BUILD_CODEC=copy
BUILD_PRESET=medium
BUILD_AUDIO_BITRATE=128k
BUILD_MAX_SLOWDOWN=3.0
BUILD_ORIGINAL_AUDIO=no_vocals
BUILD_ORIGINAL_VOLUME=10
BUILD_NO_VOCALS_VOLUME=50
BUILD_BURN_SUBS=false

# Общие
OUTPUT_DIR=./projects
