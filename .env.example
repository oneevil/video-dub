# API ключи
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
CUSTOM_API_KEY=
CUSTOM_API_URL=
OLLAMA_URL=http://localhost:11434
HF_TOKEN=hf_...  # HuggingFace токен для диаризации (WhisperX)
ELEVENLABS_API_KEY=sk_...
FISH_API_KEY=

# Перевод
TRANSLATE_PROVIDER=claude
TRANSLATE_MODEL=claude-sonnet-4-5

# Транскрипция
TRANSCRIBE_ENGINE=faster-whisper
WHISPER_MODEL=large-v3-turbo
SEPARATE_VOCALS=true

# TTS
TTS_ENGINE=omnivoice
TTS_VOICE=
TTS_SEED=44
TTS_TEMPERATURE=0.5

# Сборка
BUILD_FORMAT=mp4
BUILD_CODEC=copy
BUILD_PRESET=fast
BUILD_AUDIO_BITRATE=128k
BUILD_MAX_SLOWDOWN=3.0
BUILD_ORIGINAL_AUDIO=voiceover
BUILD_ORIGINAL_VOLUME=15
BUILD_NO_VOCALS_VOLUME=90
BUILD_VOCALS_VOLUME=15
BUILD_BURN_SUBS=false

# Общие
OUTPUT_DIR=./projects
